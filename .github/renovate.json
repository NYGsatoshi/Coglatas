{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 8,
  "prHourlyLimit": 4,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Keep major upgrades individually approved",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep coordinated npm CLI updates out of routine dependency PRs",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "Hold Gantt major migrations until install-script review",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@syncfusion/ej2-angular-gantt"
      ],
      "allowedVersions": "/^34\\./"
    },
    {
      "description": "Keep protected GitHub Actions on reviewed SHA allowlist",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "JetBrains/qodana-action",
        "SocketDev/action",
        "actions/checkout",
        "actions/dependency-review-action",
        "actions/download-artifact",
        "actions/setup-dotnet",
        "actions/setup-node",
        "actions/setup-python",
        "actions/upload-artifact",
        "aquasecurity/trivy-action",
        "github/codeql-action",
        "google/osv-scanner-action"
      ],
      "enabled": false
    },
    {
      "description": "Hold Ubuntu hosted-runner major migration pending execution qualification",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04$/"
    },
    {
      "description": "Keep Actions Python bootstrap on reviewed 3.12",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.12(\\.|$)/"
    },
    {
      "description": "Keep Actions dotnet-sdk bootstrap aligned with global.json",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dotnet-sdk"
      ],
      "allowedVersions": "10.0.401"
    },
    {
      "description": "Group compatible npm updates per review",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm compatible (minor and patch)"
    },
    {
      "description": "Group compatible NuGet updates per review",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "NuGet compatible (minor and patch)"
    },
    {
      "description": "Update GitHub Actions pins together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require dashboard approval for SDK major migration proposals",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "matchFileNames": [
        "global.json",
        "**/global.json"
      ]
    },
    {
      "description": "Retain approved Node 24 LTS for container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "/^24([.-]|$)/"
    },
    {
      "description": "Playwright Docker image must match the root Playwright lockfile",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/playwright"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "prConcurrentLimit": 5
  }
}
