{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "automerge": false,
  "prConcurrentLimit": 8,
  "prHourlyLimit": 4,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Keep major upgrades individually approved",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Keep coordinated npm CLI updates out of routine dependency PRs",
      "matchPackageNames": [
        "npm"
      ],
      "enabled": false
    },
    {
      "description": "Hold Gantt major migrations until install-script review",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@syncfusion/ej2-angular-gantt"
      ],
      "allowedVersions": "/^34\\./"
    },
    {
      "description": "Hold Stylelint 18 until SCSS config supports its peer dependency",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "stylelint"
      ],
      "allowedVersions": "/^17\\./"
    },
    {
      "description": "Exclude Angular 22.2.5-22.2.6 tooling with invalid optional peer trees",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@angular/build",
        "@angular-devkit/build-angular",
        "@angular/cli"
      ],
      "allowedVersions": "!/^22\\.2\\.[56]$/"
    },
    {
      "description": "Keep protected GitHub Actions on reviewed SHA allowlist",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "JetBrains/qodana-action",
        "SocketDev/action",
        "actions/checkout",
        "actions/dependency-review-action",
        "actions/download-artifact",
        "actions/setup-dotnet",
        "actions/setup-node",
        "actions/setup-python",
        "actions/upload-artifact",
        "aquasecurity/trivy-action",
        "github/codeql-action",
        "google/osv-scanner-action"
      ],
      "enabled": false
    },
    {
      "description": "Hold Ubuntu hosted-runner major migration pending execution qualification",
      "matchManagers": [
        "github-actions"
      ],
      "matchDatasources": [
        "github-runners"
      ],
      "matchPackageNames": [
        "ubuntu"
      ],
      "allowedVersions": "/^24\\.04$/"
    },
    {
      "description": "Keep Actions Python bootstrap on reviewed 3.12",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/python-versions"
      ],
      "allowedVersions": "/^3\\.12(\\.|$)/"
    },
    {
      "description": "Keep Actions dotnet-sdk bootstrap aligned with global.json",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dotnet-sdk"
      ],
      "allowedVersions": "10.0.403"
    },
    {
      "description": "Regenerate npm lockfiles with full installation on every update",
      "matchManagers": [
        "npm"
      ],
      "skipInstalls": false,
      "postUpdateOptions": [
        "npmInstallTwice"
      ]
    },
    {
      "description": "Keep TypeScript in Angular 22 supported peer range",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "/^6\\.0\\./"
    },
    {
      "description": "Group compatible npm updates per review",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm compatible (minor and patch)",
      "postUpdateOptions": [
        "npmInstallTwice"
      ]
    },
    {
      "description": "Keep Playwright npm updates tied to the reviewed browser image",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@playwright/test"
      ],
      "matchFileNames": [
        "package.json"
      ],
      "allowedVersions": "1.64.1"
    },
    {
      "description": "Hold malformed npm minimatch override updates for lockfile repair",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "minimatch"
      ],
      "matchFileNames": [
        "coglatas-frontend/package.json",
        "scripts/ci/sonar-operational-coverage-tools/package.json"
      ],
      "allowedVersions": "11.0.4"
    },
    {
      "description": "Hold Sonar glob updates that cannot produce installable locks",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "glob"
      ],
      "matchFileNames": [
        "scripts/ci/sonar-operational-coverage-tools/package.json"
      ],
      "allowedVersions": "14.0.3"
    },
    {
      "description": "Separate ANG22 reviewed packages from routine npm updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@angular/animations",
        "@angular/build",
        "@angular/cdk",
        "@angular/cli",
        "@angular/common",
        "@angular/compiler",
        "@angular/compiler-cli",
        "@angular/core",
        "@angular/forms",
        "@angular/platform-browser",
        "@angular/platform-browser-dynamic",
        "@angular/router",
        "@angular-devkit/architect",
        "@angular-devkit/build-angular",
        "@angular-devkit/core",
        "@lucide/angular",
        "@storybook/angular",
        "storybook",
        "@vitest/coverage-istanbul",
        "vitest"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "dependencyDashboardApproval": true,
      "groupName": "ANG22 reviewed dependency candidates"
    },
    {
      "description": "Group compatible NuGet updates per review",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "NuGet compatible (minor and patch)"
    },
    {
      "description": "Update GitHub Actions pins together",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Require dashboard approval for SDK major migration proposals",
      "matchManagers": [
        "nuget"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "matchFileNames": [
        "global.json",
        "**/global.json"
      ]
    },
    {
      "description": "Retain approved Node 26 LTS for container images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "node"
      ],
      "allowedVersions": "/^26([.-]|$)/"
    },
    {
      "description": "Playwright Docker image must match the root Playwright lockfile",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "mcr.microsoft.com/playwright"
      ],
      "enabled": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ],
    "prConcurrentLimit": 5
  },
  "constraints": {
    "npm": "11.17.0"
  }
}
