{
  "schema_version": 2,
  "source_controls": [
    "GOV-WORKFLOW-PERM-001",
    "GOV-TRUST-001",
    "GOV-RUNNER-001"
  ],
  "constraints": {
    "persist_credentials": false,
    "pull_request_target": "forbidden",
    "untrusted_pr_self_hosted": "forbidden",
    "persistent_privileged_self_hosted": "forbidden"
  },
  "runner_routing": {
    "github_hosted_labels": [
      "ubuntu-latest",
      "windows-latest",
      "macos-latest"
    ],
    "github_hosted_groups": [],
    "approved_dynamic_expressions": [
      "${{ (matrix.language == 'swift' && 'macos-latest') || 'ubuntu-latest' }}",
      "${{ (matrix.os == 'windows-latest' && 'windows-latest') || (matrix.os == 'macos-latest' && 'macos-latest') || 'ubuntu-latest' }}"
    ]
  },
  "write_permissions": [
    {
      "workflow": ".github/workflows/codeql.yml",
      "jobs": [
        "analyze"
      ],
      "events": [
        "pull_request",
        "push",
        "schedule"
      ],
      "permissions": [
        "security-events:write"
      ],
      "reason": "Publish CodeQL SARIF for pull requests, trusted main pushes, and the scheduled scan. On fork pull_request runs GitHub downgrades GITHUB_TOKEN writes while Code Scanning still permits PR result upload."
    },
    {
      "workflow": ".github/workflows/qodana_cloud_quality.yml",
      "jobs": [
        "qodana-cloud"
      ],
      "events": [
        "workflow_dispatch"
      ],
      "permissions": [
        "security-events:write"
      ],
      "reason": "Publish normalized Qodana SARIF only from the manually dispatched trusted default-branch fallback; pull-request workflows remain read-only."
    },
    {
      "workflow": ".github/workflows/main-build-artifacts.yml",
      "jobs": [
        "qodana-cloud"
      ],
      "events": [
        "push"
      ],
      "permissions": [
        "security-events:write"
      ],
      "reason": "Publish normalized Qodana SARIF from the protected main artifact-hub Cloud job after restoring the exact-SHA trusted build artifact."
    },
    {
      "workflow": ".github/workflows/nuget-dependency-submission.yml",
      "jobs": [
        "submit-nuget"
      ],
      "events": [
        "workflow_dispatch"
      ],
      "permissions": [
        "contents:write"
      ],
      "reason": "Submit the NuGet dependency snapshot from an explicitly dispatched trusted metadata-publication lane."
    },
    {
      "workflow": ".github/workflows/refresh-pr445-mobile-baseline.yml",
      "jobs": [
        "refresh-mobile-baseline"
      ],
      "events": [
        "push"
      ],
      "permissions": [
        "contents:write"
      ],
      "reason": "Commit the single scope-checked PR445 mobile screenshot baseline back to its fixed repository branch."
    },
    {
      "workflow": ".github/workflows/release-supply-chain.yml",
      "jobs": [],
      "events": [
        "release"
      ],
      "permissions": [
        "id-token:write",
        "packages:write"
      ],
      "reason": "Canonical workflow-level aggregate only. No job receives this aggregate scope; the job-specific entries below enforce exact least-privilege permissions."
    },
    {
      "workflow": ".github/workflows/release-supply-chain.yml",
      "jobs": [
        "publish-release-image",
        "promote-release-tag"
      ],
      "events": [
        "release"
      ],
      "permissions": [
        "packages:write"
      ],
      "reason": "Publish the immutable release subject and promote its human release tag only from the trusted release event; these jobs do not receive OIDC signing authority."
    },
    {
      "workflow": ".github/workflows/release-supply-chain.yml",
      "jobs": [
        "sign-release-subject"
      ],
      "events": [
        "release"
      ],
      "permissions": [
        "id-token:write",
        "packages:write"
      ],
      "reason": "Mint a short-lived GitHub Actions OIDC identity and publish Cosign signatures and attestations for the immutable release subject."
    }
  ]
}
