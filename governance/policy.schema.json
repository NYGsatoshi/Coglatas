{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NYGsatoshi/Coglatas/governance/policy.schema.json",
  "title": "Coglatas Governance Policy Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "policy_id",
    "repository",
    "default_branch",
    "owners",
    "semantics",
    "waiver_rules",
    "controls"
  ],
  "properties": {
    "$schema": {"const": "./policy.schema.json"},
    "version": {"const": 1},
    "policy_id": {"const": "COGLATAS-GOVERNANCE"},
    "repository": {"const": "NYGsatoshi/Coglatas"},
    "default_branch": {"type": "string", "minLength": 1},
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"}
    },
    "semantics": {"$ref": "#/$defs/semantics"},
    "waiver_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/waiverRule"}
    },
    "controls": {
      "type": "array",
      "minItems": 12,
      "items": {"$ref": "#/$defs/control"}
    }
  },
  "$defs": {
    "semantics": {
      "type": "object",
      "properties": {
        "live_state_is_baseline": {"const": false},
        "unknown_control_behavior": {"const": "reject"},
        "unknown_field_behavior": {"const": "reject"},
        "invalid_policy_behavior": {"const": "block"},
        "implicit_critical_defaults": {"const": "forbidden"},
        "downgrade_requires_explicit_diff": {"const": true}
      },
      "additionalProperties": false,
      "required": [
        "live_state_is_baseline",
        "unknown_control_behavior",
        "unknown_field_behavior",
        "invalid_policy_behavior",
        "implicit_critical_defaults",
        "downgrade_requires_explicit_diff"
      ]
    },
    "waiverRule": {
      "type": "object",
      "properties": {
        "owner_required": {"const": true},
        "reason_required": {"const": true},
        "expiry_required": {"const": true},
        "tracking_issue_required": {"const": true},
        "max_duration_days": {"type": "integer", "minimum": 1, "maximum": 90}
      },
      "additionalProperties": false,
      "required": [
        "owner_required",
        "reason_required",
        "expiry_required",
        "tracking_issue_required",
        "max_duration_days"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "github-live-settings",
            "status-context",
            "workflow-static",
            "repository-file",
            "governance-manifest"
          ]
        },
        "source": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "required": ["kind", "source"]
    },
    "exception": {
      "type": "object",
      "properties": {
        "allowed": {"type": "boolean"},
        "waiver_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "required": ["allowed"]
    },
    "checkReference": {
      "type": "object",
      "properties": {
        "kind": {"enum": ["workflow-job", "commit-status"]},
        "workflow": {"type": "string", "minLength": 1},
        "job": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
        "context": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "required": ["kind", "workflow", "job", "context"]
    },
    "references": {
      "type": "object",
      "properties": {
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "workflows": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/checkReference"}
        },
        "rulesets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false,
      "required": ["paths", "workflows", "checks", "rulesets"]
    },
    "writePermissionAllowlistEntry": {
      "type": "object",
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z-]+:(read|write)$"}
        }
      },
      "additionalProperties": false,
      "required": ["workflow", "permissions"]
    },
    "bypassActor": {
      "type": "object",
      "properties": {
        "actor_type": {
          "enum": ["Integration", "User", "Team", "RepositoryRole", "OrganizationAdmin", "DeployKey"]
        },
        "actor_id": {"type": "integer", "minimum": 1},
        "bypass_mode": {"enum": ["always", "pull_request"]},
        "purpose": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "break_glass": {"type": "boolean"},
        "normal_development": {"const": false},
        "rulesets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false,
      "required": [
        "actor_type",
        "actor_id",
        "bypass_mode",
        "purpose",
        "rationale",
        "break_glass",
        "normal_development",
        "rulesets"
      ],
      "allOf": [
        {
          "if": {"properties": {"actor_type": {"const": "User"}}, "required": ["actor_type"]},
          "then": {"properties": {"break_glass": {"const": true}}}
        }
      ]
    },
    "control": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "pattern": "^GOV-[A-Z0-9-]+-[0-9]{3}$"},
        "family": {
          "enum": [
            "ruleset",
            "required-status-checks",
            "required-signatures",
            "pr-review-codeowners",
            "bypass-actors",
            "workflow-permissions",
            "workflow-trust-boundary",
            "self-hosted-runner",
            "action-refs",
            "governance-sensitive-paths",
            "waiver-expiry",
            "governance-evidence"
          ]
        },
        "title": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pr", "default-branch", "release", "scheduled"]}
        },
        "enforcement": {
          "enum": ["blocking", "required-on-sensitive-change", "audit"]
        },
        "owner": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"},
        "expected": {"type": "object"},
        "evidence": {"$ref": "#/$defs/evidence"},
        "exception": {"$ref": "#/$defs/exception"},
        "references": {"$ref": "#/$defs/references"},
        "failure_classification": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "family",
        "title",
        "purpose",
        "scope",
        "enforcement",
        "owner",
        "expected",
        "evidence",
        "exception",
        "references",
        "failure_classification"
      ],
      "allOf": [
        {
          "if": {"properties": {"family": {"const": "ruleset"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/rulesetExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "required-status-checks"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/requiredChecksExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "required-signatures"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/requiredSignaturesExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "pr-review-codeowners"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/reviewExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "bypass-actors"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/bypassExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "workflow-permissions"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/workflowPermissionsExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "workflow-trust-boundary"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/trustBoundaryExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "self-hosted-runner"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/selfHostedExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "action-refs"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/actionRefsExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "governance-sensitive-paths"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/sensitivePathsExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "waiver-expiry"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/waiverExpected"}}}
        },
        {
          "if": {"properties": {"family": {"const": "governance-evidence"}}, "required": ["family"]},
          "then": {"properties": {"expected": {"$ref": "#/$defs/evidenceExpected"}}}
        }
      ]
    },
    "rulesetExpected": {
      "type": "object",
      "properties": {
        "target": {"const": "default-branch"},
        "ruleset_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "strict_required_status_checks": {"type": "boolean"},
        "branch_deletion_allowed": {"type": "boolean"},
        "non_fast_forward_allowed": {"type": "boolean"}
      },
      "additionalProperties": false,
      "required": [
        "target",
        "ruleset_names",
        "strict_required_status_checks",
        "branch_deletion_allowed",
        "non_fast_forward_allowed"
      ]
    },
    "requiredChecksExpected": {
      "type": "object",
      "properties": {
        "strict": {"type": "boolean"},
        "missing_or_stale": {"enum": ["fail"]},
        "required": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/checkReference"}
        }
      },
      "additionalProperties": false,
      "required": ["strict", "missing_or_stale", "required"]
    },
    "requiredSignaturesExpected": {
      "type": "object",
      "properties": {"required": {"type": "boolean"}},
      "additionalProperties": false,
      "required": ["required"]
    },
    "reviewExpected": {
      "type": "object",
      "properties": {
        "pull_request_required": {"const": true},
        "approvals_required": {"type": "integer", "minimum": 0},
        "codeowners_review_required": {"type": "boolean"},
        "unattributed_changes_require_additional_approval": {"type": "boolean"},
        "dismiss_stale_reviews_on_push": {"type": "boolean"},
        "require_last_push_approval": {"type": "boolean"},
        "required_review_thread_resolution": {"const": true},
        "author_cannot_self_approve": {"const": true},
        "minimum_distinct_codeowners": {"type": "integer", "minimum": 1},
        "external_pr_current_head_approval_required": {"const": true},
        "external_pr_approval_reviewer": {
          "type": "string",
          "pattern": "^@[A-Za-z0-9-]+$"
        },
        "external_approval_reviewer_must_be_codeowner": {"const": true},
        "owner_authored_pr_external_approval_required": {"type": "boolean"},
        "draft_pr_blocks": {"const": true},
        "changes_requested_blocks": {"const": true},
        "previous_head_approval_satisfies": {"const": false},
        "codeowners_fallback_required": {"const": true},
        "codeowners_required_explicit_patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "codeowners_sensitive_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false,
      "required": [
        "pull_request_required",
        "approvals_required",
        "codeowners_review_required",
        "unattributed_changes_require_additional_approval",
        "dismiss_stale_reviews_on_push",
        "require_last_push_approval",
        "required_review_thread_resolution",
        "author_cannot_self_approve",
        "minimum_distinct_codeowners",
        "external_pr_current_head_approval_required",
        "external_pr_approval_reviewer",
        "external_approval_reviewer_must_be_codeowner",
        "owner_authored_pr_external_approval_required",
        "draft_pr_blocks",
        "changes_requested_blocks",
        "previous_head_approval_satisfies",
        "codeowners_fallback_required",
        "codeowners_required_explicit_patterns",
        "codeowners_sensitive_paths"
      ]
    },
    "bypassExpected": {
      "type": "object",
      "properties": {
        "allowed_actors": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/bypassActor"}
        },
        "normal_development_bypass_forbidden": {"const": true},
        "user_always_bypass": {"enum": ["forbidden", "break-glass-only"]},
        "break_glass_usage_evidence_required": {"const": true}
      },
      "additionalProperties": false,
      "required": [
        "allowed_actors",
        "normal_development_bypass_forbidden",
        "user_always_bypass",
        "break_glass_usage_evidence_required"
      ]
    },
    "workflowPermissionsExpected": {
      "type": "object",
      "properties": {
        "default": {"enum": ["read-only"]},
        "persist_credentials": {"type": "boolean"},
        "write_permissions_allowlist": {
          "type": "array",
          "items": {"$ref": "#/$defs/writePermissionAllowlistEntry"}
        }
      },
      "additionalProperties": false,
      "required": ["default", "persist_credentials", "write_permissions_allowlist"]
    },
    "trustBoundaryExpected": {
      "type": "object",
      "properties": {
        "pull_request_target": {"enum": ["forbidden"]},
        "workflow_run_untrusted_head_execution": {"enum": ["forbidden"]},
        "untrusted_pr_write_token": {"enum": ["forbidden"]},
        "untrusted_pr_secrets": {"enum": ["forbidden"]}
      },
      "additionalProperties": false,
      "required": [
        "pull_request_target",
        "workflow_run_untrusted_head_execution",
        "untrusted_pr_write_token",
        "untrusted_pr_secrets"
      ]
    },
    "selfHostedExpected": {
      "type": "object",
      "properties": {
        "untrusted_pr": {"enum": ["forbidden"]},
        "persistent_privileged": {"enum": ["forbidden"]}
      },
      "additionalProperties": false,
      "required": ["untrusted_pr", "persistent_privileged"]
    },
    "actionRefsExpected": {
      "type": "object",
      "properties": {
        "third_party": {"enum": ["immutable-sha"]},
        "reusable_workflow": {"enum": ["immutable-sha-or-local"]},
        "mutable_tag": {"enum": ["forbidden"]}
      },
      "additionalProperties": false,
      "required": ["third_party", "reusable_workflow", "mutable_tag"]
    },
    "sensitivePathsExpected": {
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "require_nonempty_match": {"type": "boolean"},
        "catch_all": {"enum": ["forbidden"]}
      },
      "additionalProperties": false,
      "required": ["patterns", "require_nonempty_match", "catch_all"]
    },
    "waiverExpected": {
      "type": "object",
      "properties": {"rule_name": {"type": "string", "minLength": 1}},
      "additionalProperties": false,
      "required": ["rule_name"]
    },
    "evidenceExpected": {
      "type": "object",
      "properties": {
        "aggregate_context": {"type": "string", "minLength": 1},
        "bind_to": {"enum": ["exact-head-sha"]},
        "missing_stale_skipped_cancelled": {"enum": ["fail"]},
        "live_evaluator": {"enum": ["trusted-default-branch"]}
      },
      "additionalProperties": false,
      "required": [
        "aggregate_context",
        "bind_to",
        "missing_stale_skipped_cancelled",
        "live_evaluator"
      ]
    }
  }
}
