# Safe development-only placeholders for the Compose files in this repository.
# `dotnet run` on the host does not read `.env` automatically; it uses `appsettings.Development.json`
# unless you override settings with exported environment variables.
DB_HOST=db
DB_NAME=coglatas_dev
DB_USER=coglatas
DB_PASSWORD=coglatas_dev_password
POSTGRES_PORT=5432
POSTGRES_DEV_HOST_PORT=5433
COGLATAS_PORT=8080
COGLATAS_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=4200
FILE_STORAGE_MAX_FILE_SIZE_BYTES=52428800
ASPNETCORE_ENVIRONMENT=Development
NG_POLL_INTERVAL=2000
BACKEND_USE_WATCH=false

# Required only for licensed Syncfusion builds. Keep the actual value in the
# git-ignored .env file or an OS/CI secret store.
SYNCFUSION_LICENSE=

TENANCY_APP_MODE=OnPremSingleTenant
TENANCY_DEFAULT_TENANT_SLUG=default
TENANCY_RESOLUTION_STRATEGY=ConfigDefault
TENANCY_ALLOW_SWITCHING=false

SECURITY_COOKIE_SECURE_POLICY=SameAsRequest
SECURITY_REQUIRE_HTTPS=false
SECURITY_ENABLE_HSTS=false
REVERSE_PROXY_TRUST_FORWARDED_HEADERS=false
# Keep true unless the explicitly trusted proxy/tunnel is known to emit
# different X-Forwarded-For versus X-Forwarded-Proto/Host list lengths.
REVERSE_PROXY_REQUIRE_HEADER_SYMMETRY=true
# Required whenever REVERSE_PROXY_TRUST_FORWARDED_HEADERS=true. These are
# comma-delimited IP addresses and/or CIDRs for the proxy-to-app peer only.
REVERSE_PROXY_TRUSTED_PROXIES=
REVERSE_PROXY_TRUSTED_NETWORKS=
PLATFORM_ADMIN_SETUP_MODE=true

# Explicit initial admin bootstrap for Docker/VPS deployments. Leave disabled unless
# you are intentionally creating or updating the first administrator.
COGLATAS_SEED_ADMIN_ENABLED=false
COGLATAS_SEED_ADMIN_EMAIL=
COGLATAS_SEED_ADMIN_USERNAME=
COGLATAS_SEED_ADMIN_PASSWORD=

# Local development only. Set true only when you intentionally use the legacy compatibility seed path.
LOCAL_ADMIN_SEED_ON_STARTUP=false
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change_me_for_local_admin
LOCAL_ADMIN_DISPLAY_NAME=Local Admin
