{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=coglatas_test;Username=coglatas"
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "ConfigDefault",
    "AllowTenantSwitching": false,
    "SeedOnStartup": true,
    "AllowDevelopmentHeaderInProduction": false,
    "AllowDevelopmentHeaderTenantResolution": false,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "coglatas_tenant_test"
  },
  "FileStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "./data/test-files",
    "BucketName": "",
    "Endpoint": "",
    "Region": "",
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".txt", ".md", ".pdf", ".png", ".jpg", ".zip" ],
    "AllowedContentTypes": [ "text/plain", "text/markdown", "application/pdf", "image/png", "image/jpeg", "application/zip" ],
    "UseSignedUrls": false,
    "UsePathStyle": false
  },
  "Security": {
    "CookieSecurePolicy": "SameAsRequest",
    "RequireHttps": false,
    "EnableHsts": false,
    "EnableCsrfProtection": true,
    "EnableRateLimiting": false,
    "LoginLockoutEnabled": false,
    "MaxFailedLoginAttempts": 10,
    "LoginLockoutDurationMinutes": 15
  },
  "Platform": {
    "EnablePlatformAdmin": true,
    "PlatformAdminSetupMode": true,
    "AllowTenantCreationFromAdmin": true,
    "EnablePlansAndSubscriptions": true,
    "EnableUsageQuota": true
  },
  "Features": {
    "EnableRadialMenu": true,
    "EnableDockingLayout": true,
    "EnableForms": true,
    "EnableEvents": true,
    "EnableProductionTracking": true,
    "EnableWebhooks": true,
    "EnableApiTokens": true
  }
}
