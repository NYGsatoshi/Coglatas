{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=coglatas;Username=coglatas"
  },
  "FileStorage": {
    "Provider": "LocalFileSystem",
    "RootPath": "./data/files",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".zip",
      ".txt",
      ".md"
    ],
    "AllowedContentTypes": [
      "application/pdf",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "image/png",
      "image/jpeg",
      "application/zip",
      "text/plain",
      "text/markdown"
    ],
    "UseSignedUrls": false,
    "BucketName": "",
    "Region": "",
    "Endpoint": "",
    "UsePathStyle": false
  },
  "UiShell": {
    "SeedOnStartup": false
  },
  "Tenancy": {
    "AppMode": "SaaS",
    "DefaultTenantSlug": "default",
    "TenantResolutionStrategy": "Host",
    "AllowTenantSwitching": true,
    "SeedOnStartup": false,
    "AllowDevelopmentHeaderInProduction": false,
    "AllowDevelopmentHeaderTenantResolution": false,
    "DevelopmentTenantHeaderName": "X-Tenant-Slug",
    "TenantCookieName": "coglatas_tenant"
  },
  "Security": {
    "CookieSecurePolicy": "Always",
    "RequireHttps": true,
    "EnableHsts": true,
    "EnableCsrfProtection": true,
    "EnableRateLimiting": true,
    "LoginLockoutEnabled": true,
    "MaxFailedLoginAttempts": 5,
    "LoginLockoutDurationMinutes": 15,
    "PasswordHashing": {
      "Algorithm": "PBKDF2"
    }
  },
  "CommunicationSafety": {
    "MaxMessageLength": 12000,
    "MaxAttachmentsPerMessage": 5,
    "MaxPostsPerMinutePerUser": 30,
    "MaxPostsPerMinutePerConversation": 120,
    "MaxThreadCreatesPerMinutePerUser": 10,
    "MaxReportsPerHourPerUser": 20,
    "DuplicatePostWindowSeconds": 15
  },
  "Platform": {
    "EnablePlatformAdmin": true,
    "PlatformAdminSetupMode": false,
    "AllowTenantCreationFromAdmin": true,
    "EnablePlansAndSubscriptions": true,
    "EnableUsageQuota": true
  },
  "Features": {
    "EnableRadialMenu": true,
    "EnableDockingLayout": true,
    "EnableForms": true,
    "EnableEvents": true,
    "EnableProductionTracking": true,
    "EnableWebhooks": false,
    "EnableApiTokens": false
  },
  "Realtime": {
    "SubscriptionLimitPerConnection": 32,
    "SubscriptionAttemptsPerMinute": 60,
    "DispatcherBatchSize": 20,
    "DispatcherPollSeconds": 5,
    "ProcessingLockSeconds": 120,
    "InitialRetrySeconds": 5,
    "MaximumAutomaticAttempts": 10,
    "MaximumRetryMinutes": 15
  },
  "TaskDeadlineDigest": {
    "PollSeconds": 60,
    "TenantPageSize": 25,
    "SchedulePageSize": 100,
    "ClaimBatchSize": 20,
    "CandidatePageSize": 100,
    "ClaimTimeoutSeconds": 120,
    "RetrySeconds": 60
  },
  "AnnouncementPublisher": {
    "PollSeconds": 30,
    "TenantPageSize": 25,
    "ClaimBatchSize": 10,
    "ClaimTimeoutSeconds": 120,
    "RetrySeconds": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
